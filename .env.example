# ==============================================================================
# SENSEL TELEMATICS - GMAIL SMTP CONFIGURATION
# ==============================================================================

# Gmail / Google Workspace SMTP Host & Port
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Authenticated Sender Account
SMTP_USER=info@sensel.in

# Google Workspace App Password (16 characters from Google Account Security)
# Same password used in your WordPress SMTP configuration
SMTP_PASSWORD=

# ==============================================================================
# SENSEL TELEMATICS - MYSQL DATABASE CONFIGURATION (websiteLead table)
# ==============================================================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=your_database_name
# Optional: Set to true if connecting to AWS RDS or cloud database requiring SSL
MYSQL_SSL=false
